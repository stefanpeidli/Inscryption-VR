<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>5</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>InscryptionVR</AssemblyName>
    <RootNamespace>InscryptionVR</RootNamespace>
    <Version>0.3.4</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files\Epic Games\InscryptionWkwPQ</GamePath>
    <GameManagedPath>$(GamePath)\Inscryption_Data\Managed</GameManagedPath>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(MSBuildThisFileDirectory)..\..\.dependencies\BepInEx\BepInEx\core</BepInExPath>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\.dependencies\OpenVR\openvr_api.cs" Link="Vendor\OpenVR.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(GameManagedPath)\netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManagedPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManagedPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManagedPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net46" Version="1.0.3" PrivateAssets="all" />
    <!-- BepInEx 5.4.23.2 is restored by scripts/bootstrap.ps1. Never ship game assemblies. -->
    <Reference Include="BepInEx"><HintPath>$(BepInExPath)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VRModule"><HintPath>$(GameManagedPath)\UnityEngine.VRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(GameManagedPath)\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.SubsystemsModule"><HintPath>$(GameManagedPath)\UnityEngine.SubsystemsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedPath)\UnityEngine.CoreModule.dll')" Text="Set GamePath to your Inscryption installation (dotnet build -p:GamePath=...)." />
    <Error Condition="!Exists('$(BepInExPath)\BepInEx.dll')" Text="Restore BepInEx 5.4.23.2 using scripts/bootstrap.ps1, or set BepInExPath to its core directory." />
  </Target>
</Project>
